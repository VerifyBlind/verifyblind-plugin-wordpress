#: includes/Admin/SettingsPage.php:111
#: includes/Admin/Wizard.php:261
msgid "Revoke URL"
msgstr "İptal bildirimi adresi"

#: includes/Admin/SettingsPage.php:112
#: includes/Admin/Wizard.php:262
msgid "Paste this address into the partner portal → Settings → Revoke URL. When a person withdraws consent in the VerifyBlind app, their result is removed here automatically. It must be HTTPS on your registered domain."
msgstr "Bu adresi partner portalında Ayarlar → Revoke URL alanına yapıştırın. Kişi VerifyBlind uygulamasında onayını geri çektiğinde, sonucu buradan da otomatik olarak silinir. Adres, kayıtlı alan adınızda ve HTTPS olmalıdır."

#: includes/Admin/Wizard.php:118
msgid "Applies to nothing yet: choose pages or categories, or put the \"VerifyBlind lock\" block on a page."
msgstr "Henüz hiçbir yerde geçerli değil: sayfa ya da kategori seçin veya bir sayfaya \"VerifyBlind kilidi\" bloğunu ekleyin."

#: includes/Admin/Wizard.php:121
msgid "Applies to nothing yet: choose the products or product categories."
msgstr "Henüz hiçbir yerde geçerli değil: ürünleri ya da ürün kategorilerini seçin."

#: includes/Admin/Wizard.php:123
msgid "Applies to nothing yet: choose the coupons."
msgstr "Henüz hiçbir yerde geçerli değil: kuponları seçin."

#: includes/Admin/Wizard.php:135
msgid "VerifyBlind setup"
msgstr "VerifyBlind kurulumu"

#. translators: 1: number of the current step, 2: number of steps
#: includes/Admin/Wizard.php:137
#, php-format
msgid "Step %1$d of %2$d"
msgstr "Adım %1$d / %2$d"

#: includes/Admin/Wizard.php:152
msgid "Skip the setup wizard"
msgstr "Kurulum sihirbazını atla"

#: includes/Admin/Wizard.php:161
msgid "1 · Connect your site"
msgstr "1 · Sitenizi bağlayın"

#. translators: %s: partner portal link
#: includes/Admin/Wizard.php:166
#, php-format
msgid "Create a free partner account at %s and copy the API key from Settings. 2,000 verifications a month are free."
msgstr "%s adresinde ücretsiz bir partner hesabı açın ve API anahtarını Ayarlar bölümünden kopyalayın. Ayda 2.000 doğrulama ücretsizdir."

#: includes/Admin/Wizard.php:180
msgid "Save and test the connection"
msgstr "Kaydet ve bağlantıyı test et"

#: includes/Admin/Wizard.php:182
msgid "Next"
msgstr "İleri"

#: includes/Admin/Wizard.php:189
msgid "2 · What kind of site is this?"
msgstr "2 · Siteniz ne tür bir site?"

#: includes/Admin/Wizard.php:190
msgid "Choose all that apply. Each choice adds ready-made rules that you can change later."
msgstr "Size uyanların hepsini seçin. Her seçim, sonradan değiştirebileceğiniz hazır kurallar ekler."

#: includes/Admin/Wizard.php:200
msgid "needs WooCommerce"
msgstr "WooCommerce gerekir"

#: includes/Admin/Wizard.php:205
msgid "Add these rules"
msgstr "Bu kuralları ekle"

#: includes/Admin/Wizard.php:206
msgid "Skip this step"
msgstr "Bu adımı atla"

#: includes/Admin/Wizard.php:216
msgid "3 · Review your rules"
msgstr "3 · Kurallarınızı gözden geçirin"

#: includes/Admin/Wizard.php:217
msgid "Switch rules on or off here. Open a rule to choose its pages, products or coupons, or to change what it asks."
msgstr "Kuralları buradan açıp kapatın. Bir kuralın sayfalarını, ürünlerini ya da kuponlarını seçmek veya ne istediğini değiştirmek için kuralı açın."

#: includes/Admin/Wizard.php:230
msgid "No rules yet. Go back a step to add ready-made rules, or add your own under VerifyBlind → Rules."
msgstr "Henüz kural yok. Hazır kurallar eklemek için bir adım geri gidin ya da VerifyBlind → Kurallar bölümünden kendi kuralınızı ekleyin."

#: includes/Admin/Wizard.php:252
msgid "Save and continue"
msgstr "Kaydet ve devam et"

#: includes/Admin/Wizard.php:260
msgid "4 · Finish"
msgstr "4 · Bitiş"

#: includes/Admin/Wizard.php:264
msgid "Copied"
msgstr "Kopyalandı"

#: includes/Admin/Wizard.php:264
msgid "Copy"
msgstr "Kopyala"

#: includes/Admin/Wizard.php:265
#: includes/Placements/WcSite.php:127
msgid "Privacy policy"
msgstr "Gizlilik politikası"

#: includes/Admin/Wizard.php:266
msgid "A suggested paragraph for your privacy policy is in the WordPress privacy policy guide, under \"VerifyBlind\"."
msgstr "Gizlilik politikanız için önerilen paragrafı WordPress gizlilik politikası rehberinde, \"VerifyBlind\" başlığı altında bulabilirsiniz."

#: includes/Admin/Wizard.php:267
msgid "Open the policy guide"
msgstr "Politika rehberini aç"

#: includes/Admin/Wizard.php:268
msgid "Trying it out"
msgstr "Denemek için"

#: includes/Admin/Wizard.php:269
msgid "Test mode (VerifyBlind → Settings) accepts the demo card of the VerifyBlind app. The demo card only works with a test partner account (ask support@verifyblind.com); with your regular partner account, verify with your own ID card. Turn test mode off on a live site."
msgstr "Test modu (VerifyBlind → Ayarlar) VerifyBlind uygulamasındaki demo kartı kabul eder. Demo kart yalnızca test partner hesabıyla çalışır (support@verifyblind.com adresinden isteyin); normal partner hesabınızla kendi kimlik kartınızla doğrulayın. Canlı sitede test modunu kapatın."

#: includes/Admin/Wizard.php:273
msgid "Finish"
msgstr "Bitir"

#: includes/ApiClient.php:120
msgid "Enter your API key first."
msgstr "Önce API anahtarınızı yazın."

#: includes/ApiClient.php:125
msgid "VerifyBlind could not be reached from this server."
msgstr "Bu sunucudan VerifyBlind'a ulaşılamadı."

#: includes/ApiClient.php:129
msgid "Connected. Your API key works."
msgstr "Bağlantı kuruldu. API anahtarınız çalışıyor."

#. translators: %d: HTTP status code
#: includes/ApiClient.php:137
#: includes/ApiErrors.php:66
#, php-format
msgid "Unexpected response from VerifyBlind (HTTP %d)."
msgstr "VerifyBlind'dan beklenmeyen bir yanıt geldi (HTTP %d)."

#: includes/ApiErrors.php:57
msgid "The API key was rejected. Copy it again from partner.verifyblind.com → Settings."
msgstr "API anahtarı kabul edilmedi. Anahtarı partner.verifyblind.com → Ayarlar bölümünden yeniden kopyalayın."

#: includes/ApiErrors.php:59
msgid "The free monthly quota is used up and there is no balance. Add balance in the partner portal."
msgstr "Aylık ücretsiz kota doldu ve bakiye yok. Partner portalından bakiye yükleyin."

