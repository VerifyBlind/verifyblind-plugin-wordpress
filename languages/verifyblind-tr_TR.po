#: includes/Admin/RulesPage.php:212
msgid "Recognise the same person across accounts (visitors log in first; on the sign-up form they verify while creating the account)"
msgstr "Farklı hesaplardaki aynı kişiyi tanı (ziyaretçiler önce giriş yapar; üye kaydı formunda ise hesabı oluştururken doğrular)"

#: includes/Admin/RulesPage.php:213
#: includes/Admin/Wizard.php:251
msgid "Each requested item counts as one verification: age = 1, one-person check = 1. 2,000 verifications a month are free."
msgstr "İstenen her öğe bir doğrulama sayılır: yaş = 1, tek kişi kontrolü = 1. Ayda 2.000 doğrulama ücretsizdir."

#: includes/Admin/RulesPage.php:215
msgid "3 · Same person on another account"
msgstr "3 · Aynı kişi başka bir hesapta"

#: includes/Admin/RulesPage.php:220
