#: includes/Admin/SettingsPage.php:80
#, php-format
msgid "Get it from %s → Settings. Free account; 2,000 verifications a month are free."
msgstr "Anahtarı %s → Ayarlar bölümünden alın. Hesap ücretsiz; ayda 2.000 doğrulama da ücretsiz."

#: includes/Admin/SettingsPage.php:88
msgid "Test mode"
msgstr "Test modu"

#: includes/Admin/SettingsPage.php:89
msgid "Accept verifications made with the demo card. Turn off on a live site."
msgstr "Demo kartla yapılan doğrulamaları kabul et. Canlı sitede kapatın."

#: includes/Admin/SettingsPage.php:92
msgid "Verified badge"
msgstr "Doğrulama rozeti"

#: includes/Admin/SettingsPage.php:97
msgid "A small \"Verified with VerifyBlind\" badge next to the name of members who passed the one-person check."
msgstr "Tek kişi kontrolünü geçen üyelerin adının yanında küçük bir \"VerifyBlind ile doğrulandı\" rozeti."

#: includes/Admin/SettingsPage.php:104
msgid "Connection"
msgstr "Bağlantı"

#: includes/Admin/SettingsPage.php:108
msgid "Test connection"
